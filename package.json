{
  "name": "pi-atlas",
  "private": true,
  "version": "0.3.0",
  "description": "PI ATLAS — The Geometry of a Life. Piin desimaalien hakuväline, kultaisen kulman spiraali, oktaedrikartta ja tilastollinen kontrolli.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/artifact-wrap.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.cjs"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
